# Environment variables for the EC-CUBE container (cp eccube.env.sample eccube.env and edit)
# docker run --env-file format: do not quote values

# Required
DATABASE_URL=mysql://eccube:secret@db:3306/eccube
# Must never change once set (used for password hashing). e.g. openssl rand -hex 32
ECCUBE_AUTH_MAGIC=change-me

# Optional
#DATABASE_SERVER_VERSION=8.4
#MAILER_DSN=smtp://user:pass@smtp.example.com:587
#ECCUBE_ADMIN_ROUTE=admin
#TRUSTED_HOSTS=^www\.example\.com$
#TRUSTED_PROXIES=10.0.0.0/8
#ECCUBE_FORCE_SSL=1
#ECCUBE_TEMPLATE_CODE=default
